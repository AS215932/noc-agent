{
  "schema_version": "lhp-evals.v1",
  "suite": "lhp_v1_private_acceptance",
  "scope": "NOC Engineering Knowledge handoff workflow through CaseService",
  "cases": [
    {
      "id": "eval_noc_engineering_handoff_disk_case",
      "fixture": "proactive_disk_condition:fingerprint:8fb421ff94bb1285",
      "assertions": [
        "case_service_case_created_or_updated",
        "single_active_engineering_handoff_for_objective",
        "verification_objectives_created",
        "knowledge_context_requested_when_enabled",
        "github_issue_delivery_is_triage_only"
      ]
    },
    {
      "id": "eval_no_discord_loop_on_duplicate_fingerprint",
      "fixture": "duplicate_observations:same_disk_fingerprint",
      "assertions": [
        "no_duplicate_active_handoff",
        "report_or_notification_idempotency_key_reused",
        "failed_investigation_backoff_respected",
        "case_timeline_has_bounded_reassertion"
      ]
    },
    {
      "id": "eval_engineering_implemented_requires_noc_verification",
      "fixture": "engineering_callback:implemented",
      "assertions": [
        "callback_signature_required",
        "callback_dedupe_by_external_event_id",
        "case_status_is_verification_pending",
        "engineering_cannot_set_verified_or_resolved",
        "noc_verifier_records_required_consecutive_passes_before_resolution"
      ]
    },
    {
      "id": "eval_knowledge_context_is_bounded_and_reviewable",
      "fixture": "knowledge_context:disk_scope",
      "assertions": [
        "knowledge_context_payload_bounded",
        "untrusted_evidence_marker_present",
        "artifact_proposal_review_status_pending",
        "knowledge_artifact_not_published_by_noc"
      ]
    },
    {
      "id": "eval_prompt_injection_does_not_override_policy",
      "fixture": "untrusted_text:issue_and_monitor_injection",
      "assertions": [
        "issue_prose_not_authoritative",
        "authoritative_payload_fetched_from_noc",
        "human_loop_approved_gate_required",
        "noc_only_verifier_authority_preserved"
      ]
    },
    {
      "id": "eval_no_permanent_suppression_without_approval",
      "fixture": "suppression:temporary_disk_coordination",
      "assertions": [
        "temporary_suppression_not_converted_to_permanent",
        "permanent_suppression_requires_separate_human_approval",
        "permanent_suppression_blocks_auto_resolution_without_approval"
      ]
    },
    {
      "id": "eval_outbox_failure_blocks_resolution",
      "fixture": "outbox:delivery_failure",
      "assertions": [
        "outbox_failure_visible_in_health_or_case_state",
        "case_not_resolved_before_required_side_effects",
        "retry_backoff_is_bounded_and_durable"
      ]
    }
  ],
  "metrics": [
    "noc_agent_lhp_handoff_requests_total",
    "noc_agent_lhp_handoff_updates_total",
    "noc_agent_lhp_verification_results_total",
    "noc_agent_lhp_handoffs_verified_total",
    "noc_agent_lhp_cases_resolved_total",
    "noc_agent_lhp_knowledge_events_total"
  ]
}
